---
title: Elsworth Artworks
body_class: album_list
---
<% current_page.data.subtitle = "#{category}"%>
<% albums = contents.group_by {|item| item[:album].downcase.to_sym} %>
<% album_cnt = 0 %>
<% albums.each do |album, list| %>
  <%
    fav_category = data.site_info.favorites[category]
    if fav_category && fav_category[album]
      basename = fav_category[album]
      item = list.find { |i| i[:basename] == basename }
    else
      item = list[0]
    end
    
    # Set section_class to wide if image is wide, or circles or last and alone
    section_class = ""
    section_class = "wide" if item[:height] && item[:width].to_f/item[:height].to_f > 2.0
    section_class = "wide" if item[:album] == "Circles"
    album_cnt += 1
    album_cnt += 1 if section_class == "wide"
    # Make the last album "wide" if it will be on its own.
    if albums.keys.last == album
      # If total number of albums is odd, the last one will be by itself on a row
      section_class = "wide" if album_cnt.odd?
    end
  %>
  <section class="<%= section_class  %>">
    <figure class="<%= item[:album] %>">
      <%= link_to image_tag(img_path(item), {:alt => item[:title]}), album_path(item) %>
    </figure>
    <h3><%= album %></h3>
  </section>
<% end %>
